{
  "name": "obelos",
  "version": "0.1.0-alpha.0",
  "description": "CI for agent context: lint, score and test CLAUDE.md, AGENTS.md, Cursor and Copilot instruction files.",
  "keywords": [
    "agents",
    "claude-code",
    "agents-md",
    "cursor",
    "copilot",
    "lint",
    "ci",
    "llm",
    "contextops",
    "linter"
  ],
  "homepage": "https://github.com/Episteme-Research-Studio/obelos#readme",
  "bugs": {
    "url": "https://github.com/Episteme-Research-Studio/obelos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Episteme-Research-Studio/obelos.git"
  },
  "author": "Episteme Research Studio",
  "license": "MIT",
  "type": "module",
  "bin": {
    "obelos": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "self-lint": "node dist/cli.js lint .",
    "smoke": "node scripts/smoke.mjs",
    "corpus:sample": "node scripts/corpus.mjs sample",
    "corpus:fetch": "node scripts/corpus.mjs fetch",
    "corpus:run": "node scripts/corpus.mjs run",
    "corpus:report": "node scripts/corpus.mjs report"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picomatch": "^4.0.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.1",
    "ajv": "^8.20.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
